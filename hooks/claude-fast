#!/bin/bash
# claude-fast — menial-task headless claude, fully LOCAL (MLX via LiteLLM).
# Usage: claude-fast "your tiny prompt"   (args after -- pass through to claude)
# Requires: mlx_lm.server on :8901 + anthropic-shim on :4000 (see ~/.claude/local-llm/).
# Measured: ~5.1s vs ~7s remote via claude -p; direct shim calls 0.10-0.16s (10-20x vs remote).
# If local stack is down, falls back to remote with a warning.
set -uo pipefail

if curl -s -o /dev/null --max-time 1 http://localhost:4000/health/liveliness; then
  exec env ANTHROPIC_BASE_URL=http://localhost:4000 \
          ANTHROPIC_AUTH_TOKEN=local-dummy \
          claude -p "$@"
else
  echo "claude-fast: local LLM stack down (litellm :4000) — falling back to REMOTE" >&2
  exec claude -p "$@"
fi
