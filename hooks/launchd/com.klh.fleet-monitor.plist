<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.klh.fleet-monitor</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__HOME__/.claude/hooks/bin/monitor.ts</string>
    <string>--fix</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/fleet-monitor.log</string>
  <key>StandardErrorPath</key><string>/tmp/fleet-monitor.log</string>
</dict></plist>
