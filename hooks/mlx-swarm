#!/bin/bash
# mlx-swarm — manage the local LLM specialist swarm.
# Starts all Tier 1 specialists (always resident, ~13GB) on dedicated ports.
# Tier 2 (coder 30B) loads on demand via mlx-load-coder.
#
# Usage:
#   mlx-swarm start    # start all Tier 1 specialists + router
#   mlx-swarm stop     # stop everything
#   mlx-swarm status   # show what's running
#   mlx-swarm restart  # stop + start

set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

MLX_PYTHON=~/.local/share/uv/tools/mlx-lm/bin/python

# Port assignments (stable across restarts)
declare -A MODELS=(
  [8901]="mlx-community/Qwen3-4B-Instruct-2507-4bit"          # menial/extract (non-thinking)
  [8902]="mlx-community/Qwen3.5-9B-MLX-4bit"                   # general/reasoning/Danish
  [8903]="mlx-community/translategemma-4b-it-4bit"             # translation
  [8904]="mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ"         # embeddings
  [8905]="mlx-community/Qwen3-Reranker-0.6B-4bit"              # reranking
)
CODER_MODEL="mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit"   # tier 2 (on demand)
CODER_PORT=8906
ROUTER_SCRIPT="$HOME/.claude/local-llm/router-shim.ts"
LOG_DIR="$HOME/.claude-insights"

start_specialist() {
  local port=$1 model=$2
  if curl -s -o /dev/null --max-time 1 "http://localhost:$port/v1/models" 2>/dev/null; then
    echo "  ✓ :$port already running"
    return
  fi
  echo "  → :$port $(basename $model)..."
  # Non-thinking flag for Qwen3 models
  local extra_args=""
  if [[ "$model" == *Qwen3-4B-Instruct* ]] || [[ "$model" == *Qwen3.5* ]]; then
    extra_args='--chat-template-args {"enable_thinking":false}'
  fi
  nohup $MLX_PYTHON -m mlx_lm.server \
    --port "$port" \
    --model "$model" \
    $extra_args \
    > "$LOG_DIR/mlx-$port.log" 2>&1 &
}

stop_port() {
  local port=$1
  if lsof -ti :$port >/dev/null 2>&1; then
    kill $(lsof -ti :$port) 2>/dev/null
    echo "  ✓ stopped :$port"
  fi
}

wait_ready() {
  local port=$1 timeout=${2:-60}
  for ((i=0; i<timeout/2; i++)); do
    sleep 2
    if curl -s -o /dev/null --max-time 1 "http://localhost:$port/v1/models" 2>/dev/null; then
      echo "  ✓ :$port ready (${i}s)"
      return 0
    fi
  done
  echo "  ✗ :$port not ready after ${timeout}s"
  return 1
}

cmd_start() {
  echo "Starting specialist swarm..."
  for port in "${!MODELS[@]}"; do
    start_specialist "$port" "${MODELS[$port]}"
  done
  echo "Waiting for models to load..."
  for port in "${!MODELS[@]}"; do
    wait_ready "$port" 90
  done
  # Start the router-shim (Anthropic API on :4000)
  if ! curl -s -o /dev/null --max-time 1 http://localhost:4000/health/liveliness 2>/dev/null; then
    echo "  → router-shim :4000..."
    nohup bun "$ROUTER_SCRIPT" > "$LOG_DIR/mlx-router.log" 2>&1 &
    sleep 2
  fi
  echo ""
  echo "Swarm ready:"
  for port in "${!MODELS[@]}"; do
    MODEL=$(basename "${MODELS[$port]}")
    STATUS=$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$port/v1/models" 2>/dev/null)
    echo "  :$port  $MODEL  $([ "$STATUS" = "200" ] && echo "✓" || echo "✗")"
  done
  echo "  :4000  router-shim (Anthropic API)"
  echo ""
  echo "Usage: claude-fast <prompt> or curl http://localhost:4000/v1/messages"
}

cmd_stop() {
  echo "Stopping swarm..."
  stop_port 4000
  for port in "${!MODELS[@]}"; do
    stop_port "$port"
  done
  stop_port $CODER_PORT
  echo "All stopped."
}

cmd_status() {
  echo "Swarm status:"
  for port in "${!MODELS[@]}"; do
    MODEL=$(basename "${MODELS[$port]}")
    if curl -s -o /dev/null --max-time 1 "http://localhost:$port/v1/models" 2>/dev/null; then
      RAM=$(ps -o rss= -p $(lsof -ti :$port 2>/dev/null) 2>/dev/null | head -1 | awk '{printf "%.1fGB", $1/1024/1024}')
      echo "  ✓ :$port  $MODEL  ($RAM)"
    else
      echo "  ✗ :$port  $MODEL  (not running)"
    fi
  done
  # Router
  if curl -s -o /dev/null --max-time 1 http://localhost:4000/health/liveliness 2>/dev/null; then
    echo "  ✓ :4000  router-shim"
  else
    echo "  ✗ :4000  router-shim (not running)"
  fi
  # Coder (tier 2)
  if curl -s -o /dev/null --max-time 1 "http://localhost:$CODER_PORT/v1/models" 2>/dev/null; then
    echo "  ✓ :$CODER_PORT  $(basename $CODER_MODEL) (tier 2, loaded)"
  else
    echo "  - :$CODER_PORT  $(basename $CODER_MODEL) (tier 2, on demand)"
  fi
}

cmd_load_coder() {
  if curl -s -o /dev/null --max-time 1 "http://localhost:$CODER_PORT/v1/models" 2>/dev/null; then
    echo "✓ coder already loaded on :$CODER_PORT"
    return
  fi
  echo "Loading code specialist ($(basename $CODER_MODEL), ~17GB)..."
  nohup $MLX_PYTHON -m mlx_lm.server \
    --port $CODER_PORT \
    --model "$CODER_MODEL" \
    > "$LOG_DIR/mlx-coder.log" 2>&1 &
  wait_ready $CODER_PORT 120
}

cmd_unload_coder() {
  stop_port $CODER_PORT
  echo "Code specialist unloaded (RAM freed)"
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  restart) cmd_stop; sleep 2; cmd_start ;;
  load-coder) cmd_load_coder ;;
  unload-coder) cmd_unload_coder ;;
  *)
    echo "Usage: mlx-swarm {start|stop|status|restart|load-coder|unload-coder}"
    echo ""
    echo "Specialists:"
    for port in "${!MODELS[@]}"; do
      echo "  :$port  $(basename "${MODELS[$port]}")"
    done
    echo "  :$CODER_PORT  $(basename $CODER_MODEL) (on demand)"
    echo "  :4000  router-shim (Anthropic API entrypoint)"
    ;;
esac
