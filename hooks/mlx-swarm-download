#!/bin/bash
# Download the specialist swarm models for MLX
set -uo pipefail
MLX_PYTHON=~/.local/share/uv/tools/mlx-lm/bin/python

MODELS=(
  "mlx-community/Qwen3-4B-Instruct-2507-4bit"       # menial (non-thinking, ~3GB)
  "mlx-community/Qwen3.5-9B-MLX-4bit"                # general + Danish (~5.6GB)
  "mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ"      # embeddings (~0.4GB)
  "mlx-community/Qwen3-Reranker-0.6B-4bit"           # reranking (~0.4GB)
  "mlx-community/translategemma-4b-it-4bit"           # translation (~2.5GB)
  "mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit"  # code specialist (~17GB)
)

echo "Downloading ${#MODELS[@]} specialist models (total ~29GB)..."
for MODEL in "${MODELS[@]}"; do
  NAME=$(basename "$MODEL")
  echo "  → $NAME..."
  $MLX_PYTHON -c "
from huggingface_hub import snapshot_download
snapshot_download('$MODEL')
print('  ✓ $NAME done')
" 2>/dev/null &
done

echo ""
echo "All downloads started in parallel. Total ~29GB."
echo "Monitor: watch -n 5 'du -sh ~/Library/Caches/huggingface/hub/ | tail -1'"
wait
echo "✓ All downloads complete"
