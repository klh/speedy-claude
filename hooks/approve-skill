#!/bin/bash
# approve-skill — mint a SIGNED, single-use skill-install approval.
# Called by the agent AFTER skill-security-review returns PASS. Writes an
# HMAC-signed verdict file that hooks/gates/bash.ts consumes exactly once,
# bound to the specific source argument. Replaces the spoofable
# --security-reviewed string marker (security-review finding H2).
#
# Usage: approve-skill <source-ref>          # e.g. "alisonaquinas/llm-shared-skills@v1.8.1/zsh"
set -euo pipefail

SRC="${1:?usage: approve-skill <source-ref>}"
SECRET_FILE="$HOME/.claude/.skill-review-secret"
DIR="$HOME/.claude-insights/.approvals"
[ -f "$SECRET_FILE" ] || { echo "no secret — run: head -c 32 /dev/urandom | xxd -p -c 32 > $SECRET_FILE; chmod 600 $SECRET_FILE" >&2; exit 1; }
mkdir -p "$DIR"; chmod 700 "$DIR"

TS="$(date +%s)"
SIG="$(printf '%s|%s' "$SRC" "$TS" | openssl dgst -sha256 -hmac "$(cat "$SECRET_FILE")" -hex | awk '{print $NF}')"
F="$DIR/${TS}.approval"
printf 'src=%s\nts=%s\nsig=%s\n' "$SRC" "$TS" "$SIG" > "$F"
chmod 600 "$F"
echo "approval minted for: $SRC"
echo "(the gate consumes ${TS}.approval on the next matching install; expires in 24h)"
